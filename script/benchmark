#!/usr/bin/env ruby
# frozen_string_literal: true

# Benchmark script to compare performance of optimized code
# This script is for development purposes only

require 'benchmark'
require 'bundler/setup'
require_relative '../lib/word-to-markdown'

# Mock document HTML with many styled elements
def create_test_html
  html_parts = ['<html><body>']

  # Add many styled elements to simulate a large document
  100.times do |i|
    size = 12 + ((i % 5) * 10)
    html_parts << "<p style='font-size: #{size}px'>Paragraph #{i}</p>"
  end

  # Add list items
  html_parts << '<ul>'
  50.times do |i|
    html_parts << "<li><span>List item #{i}</span></li>"
  end
  html_parts << '</ul>'

  # Add table
  html_parts << '<table><tr><td>Header 1</td><td>Header 2</td></tr>'
  20.times do |i|
    html_parts << "<tr><td><p>Cell #{i}-1</p></td><td><p>Cell #{i}-2</p></td></tr>"
  end
  html_parts << '</table>'

  html_parts << '</body></html>'
  html_parts.join
end

puts 'Performance Benchmark for word-to-markdown optimizations'
puts '=' * 60
puts

# NOTE: This benchmark focuses on the converter operations since
# the full document conversion requires LibreOffice which may not be available
puts 'Note: This benchmark tests the optimized methods in isolation.'
puts 'It demonstrates the improvements in DOM traversal and processing.'
puts

html = create_test_html
puts "Test document: #{html.length} characters, simulating a medium-sized document"
puts

# Benchmark the key operations
Benchmark.bmbm do |x|
  # Parse the HTML once to create a document tree
  tree = Nokogiri::HTML(html)

  x.report('CSS selector (td > p):') do
    1000.times { tree.css('td > p').each { |n| } }
  end

  x.report('CSS selector (td p):') do
    1000.times { tree.css('td p').each { |n| } }
  end

  x.report('Process styled elements (single pass):') do
    100.times do
      headings = []
      sizes = []
      tree.css('[style]').each do |element|
        font_size = element['style']&.match(/font-size:\s*(\d+)/)&.[](1)&.to_f
        unless font_size.nil?
          sizes.push font_size.round(-1)
          headings.push element if font_size >= 20
        end
      end
    end
  end

  x.report('Process styled elements (two passes):') do
    100.times do
      # First pass for headings
      headings = []
      tree.css('[style]').each do |element|
        font_size = element['style']&.match(/font-size:\s*(\d+)/)&.[](1)&.to_f
        headings.push element if !font_size.nil? && font_size >= 20
      end

      # Second pass for sizes
      sizes = []
      tree.css('[style]').each do |element|
        font_size = element['style']&.match(/font-size:\s*(\d+)/)&.[](1)&.to_f
        sizes.push font_size.round(-1) unless font_size.nil?
      end
    end
  end
end

puts
puts 'Results show the performance improvement from:'
puts '  1. Using direct child selectors (>) vs descendant selectors'
puts '  2. Combining multiple DOM traversals into a single pass'
puts
puts 'These optimizations reduce redundant DOM traversals and improve'
puts 'overall conversion performance, especially for large documents.'
