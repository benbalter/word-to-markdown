#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'word-to-markdown'

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: w2m path/to/document.docx'

  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit
  end

  opts.on('-v', '--version', 'Show the WordToMarkdown and LibreOffice versions') do
    puts "WordToMarkdown v#{WordToMarkdown::VERSION}"
    puts "LibreOffice v#{WordToMarkdown.soffice.version}" unless Gem.win_platform?
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn e.message
  warn parser
  exit 1
end

if ARGV.size != 1
  warn parser
  exit 1
end

puts WordToMarkdown.new(ARGV[0])
